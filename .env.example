# CourtDesk — секреты приложения
# Скопируйте в .env и заполните значения.

# RuCaptcha — для мировых судов (*.msudrf.ru)
RUCAPTCHA_API_KEY=

# 2captcha.com — fallback
TWOCAPTCHA_API_KEY=

# Порт API-сервера (по умолчанию 8767)
PORT=8767

# Bind-адрес (127.0.0.1 для локалки, 0.0.0.0 для контейнера/reverse-proxy)
HOST=127.0.0.1

# API-токен (опционально). Если задан — mutating-эндпоинты требуют header X-API-Token
COURTDESK_API_TOKEN=

# Headless-режим Puppeteer (false = видимое окно браузера, для отладки)
PUPPETEER_HEADLESS=shell
