{
  "name": "courtdesk",
  "version": "0.7.0",
  "description": "CRM-оркестратор поиска и мониторинга судебных дел РФ.",
  "keywords": [
    "court",
    "sudrf",
    "msudrf",
    "legal",
    "monitoring",
    "crm",
    "russian-courts"
  ],
  "homepage": "https://github.com/AlexanderKuzikov/CourtDesk#readme",
  "bugs": {
    "url": "https://github.com/AlexanderKuzikov/CourtDesk/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "puppeteer@25.3.0": true
  },
  "author": "Alexander Kuzikov (https://github.com/AlexanderKuzikov)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexanderKuzikov/CourtDesk.git"
  },
  "type": "module",
  "scripts": {
    "start": "npx tsx packages/api/server.ts",
    "tui": "npx tsx packages/tui/index.tsx",
    "dev": "npx tsx --watch packages/api/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "npx tsc --noEmit",
    "lint:biome": "biome lint"
  },
  "dependencies": {
    "@types/react": "^19.2.17",
    "cheerio": "^1.0.0",
    "express": "^5.2.1",
    "iconv-lite": "^0.7.3",
    "ink": "^7.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^25.3.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "supertest": "^7.0.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
