{
  "name": "courtdesk",
  "version": "0.1.0",
  "description": "CRM-оркестратор поиска и мониторинга судебных дел РФ. Объединяет CourtSniffer (поиск) и CourtFlow (мониторинг) в единый рабочий стол юриста с подсказками сценариев и хранением состояния.",
  "keywords": [
    "court",
    "sudrf",
    "msudrf",
    "legal",
    "monitoring",
    "crm",
    "russian-courts"
  ],
  "homepage": "https://github.com/AlexanderKuzikov/CourtDesk#readme",
  "bugs": {
    "url": "https://github.com/AlexanderKuzikov/CourtDesk/issues"
  },
  "license": "Apache-2.0",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "puppeteer@25.3.0": true
  },
  "author": "Alexander Kuzikov (https://github.com/AlexanderKuzikov)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexanderKuzikov/CourtDesk.git"
  },
  "type": "module",
  "scripts": {
    "start": "npx tsx packages/api/server.ts",
    "dev": "npx tsx --watch packages/api/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npx tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^5.2.1",
    "iconv-lite": "^0.7.3",
    "puppeteer": "^25.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
